Options -Indexes +FollowSymLinks

RewriteEngine On

# Let real files pass through (JS, CSS, images, fonts)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Let the /api/ subdirectory handle its own requests
RewriteRule ^api(/|$) - [L]

# SPA: send everything else to index.html
RewriteRule ^ /index.html [QSA,L]
